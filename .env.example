# Copie para .env (cp .env.example .env) e TROQUE todas as senhas/tokens. O docker compose lê o .env
# automaticamente e se recusa a subir se alguma variável obrigatória faltar.
# Os valores abaixo servem só para desenvolvimento local e CI. Em produção, use um cofre de segredos
# (Vault, AWS Secrets Manager, Azure Key Vault): veja docs/seguranca.md.

# PostgreSQL
POSTGRES_DB=logistics_db
POSTGRES_USER=user_admin
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# Token de serviço backend-core → ai-engine (gere com: openssl rand -hex 32)
AI_ENGINE_TOKEN=troque-este-token-de-servico

# Keycloak: administrador do console (http://localhost:8180) e senha dos usuários de desenvolvimento
# do realm smartroute (admin.dev, despacho.dev, motorista.dev)
KEYCLOAK_ADMIN_USER=kc-admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha-do-keycloak
KEYCLOAK_DEV_USERS_PASSWORD=troque-esta-senha-dev

# Grafana (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-do-grafana

SPRING_PROFILES_ACTIVE=dev
# Origens do frontend autorizadas a chamar a API (CORS), separadas por vírgula. Nunca "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# O Nominatim exige um User-Agent que identifique a aplicação (de preferência com contato)
GEOCODING_USER_AGENT=SmartRouteLogistics/0.1 (+https://github.com/carlosjc31/smartroute-logistics)
