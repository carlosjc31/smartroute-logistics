# Origem da API em produção. Vazio = mesma origem (em dev o Vite faz proxy de /api).
VITE_API_URL=
# Destino do proxy de desenvolvimento (padrão http://localhost:8080)
VITE_PROXY_TARGET=http://localhost:8080
# Login OIDC (Keycloak do docker compose). Client público com PKCE: não há segredo no frontend.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/smartroute
VITE_OIDC_CLIENT_ID=smartroute-frontend
